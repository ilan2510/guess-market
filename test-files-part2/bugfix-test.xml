<Guess-Market xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="GM-EX2-Schema.xsd">
<GM-events>
<GM-event name="Cost basis and self-trade test">
<id>1</id>
<description>Testing cost basis fix and self-trade exclusion</description>
<commission type="on-purchase">0</commission>
<GM-options>
<GM-option>Yes</GM-option>
<GM-option>No</GM-option>
</GM-options>
<GM-method>
<GM-order-book allow-mint="false" initial="20" d="1"/>
</GM-method>
</GM-event>
<GM-event name="Uneven division test">
<id>2</id>
<description>Testing leftover refund when initial does not divide evenly by d</description>
<commission type="on-purchase">0</commission>
<GM-options>
<GM-option>Yes</GM-option>
<GM-option>No</GM-option>
</GM-options>
<GM-method>
<GM-order-book allow-mint="false" initial="100" d="3"/>
</GM-method>
</GM-event>
</GM-events>
<GM-users>
<GM-user name="Owner">
<initial-cash>200</initial-cash>
<GM-market-maker>
<event id="1"/>
<event id="2"/>
</GM-market-maker>
</GM-user>
<GM-user name="Trader">
<initial-cash>200</initial-cash>
</GM-user>
</GM-users>
</Guess-Market>
